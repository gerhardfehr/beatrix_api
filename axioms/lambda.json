      "formula": "∂(Peer_Punishment)/∂(Institution_Stärke) < 0 für hohe Institution_Stärke",
      "dependencies": ["LAM-INS-03"],
      "testable": true
    },
    {
      "id": "LAM-INS-11",
      "category": "institutions",
      "level": "dynamics",
