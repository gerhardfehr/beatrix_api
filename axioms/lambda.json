      "description": "Je stärker Abweichung von Norm, desto härter Bestrafung",
      "formula": "Punishment_ij = f(c_i - c_j), steigend für c_i > c_j",
      "dependencies": ["LAM-INS-07"],
      "testable": true
    },
    {
      "id": "LAM-INS-09",
