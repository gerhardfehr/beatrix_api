    {
      "id": "BR-FS-01",
      "category": "fairness",
      "level": "foundation",
      "statement": "Neid-Parameter α aus Fehr/Schmidt",
      "description": "Disutility aus nachteiliger Ungleichheit (ich bekomme weniger)",
      "parameter": "α",
      "value": 2.0,
      "range": [0.5, 4.0],
      "formula": "U_FS = x_i - α·max(x_j - x_i, 0) - β·max(x_i - x_j, 0)",
      "constraint": "α ≥ β (empirisch validiert)",
      "confidence": "high",
      "source": "Fehr & Schmidt (1999), QJE",
      "evidence": "Fitted to UG rejection rates and DG giving"
    },
    {
      "id": "BR-FS-02",
      "category": "fairness",
      "level": "foundation",
      "statement": "Schuld-Parameter β aus Fehr/Schmidt",
      "description": "Disutility aus vorteilhafter Ungleichheit (ich bekomme mehr)",
      "parameter": "β",
      "value": 0.6,
      "range": [0.0, 0.6],
      "constraint": "0 ≤ β < 1 (sonst würde Agent Geld verbrennen)",
      "confidence": "high",
      "source": "Fehr & Schmidt (1999), QJE",
      "evidence": "Fitted to DG giving patterns"
    },
    {
      "id": "BR-FS-03",
      "category": "fairness",
      "level": "structure",
      "statement": "Asymmetrie α > β ist universell",
      "description": "Menschen reagieren stärker auf Benachteiligung als auf Bevorteilung",
      "formula": "α/β ≈ 3.3 (typisch)",
      "rationale": "Loss aversion im sozialen Vergleich",
      "confidence": "high",
      "source": "Fehr & Schmidt (1999), repliziert in >100 Studien",
      "testable": true
    },
    {
      "id": "BR-FS-04",
      "category": "fairness",
      "level": "structure",
      "statement": "Heterogenität in α und β",
      "description": "Erhebliche individuelle Unterschiede in Fairness-Präferenzen",
      "distribution": {
        "alpha": "Rechtsschief, Median < Mean",
        "beta": "Viele bei 0, Peak bei ~0.4",
        "correlation": "r(α,β) ≈ 0.3-0.5"
      },
      "confidence": "high",
      "source": "Blanco et al. (2011), GEB"
    },
    {
      "id": "BR-FS-05",
      "category": "fairness",
      "level": "operation",
      "statement": "Kontextabhängigkeit von α und β",
      "description": "Fairness-Parameter sind nicht stabil über Kontexte",
      "modifiers": {
        "anonymity": "Mehr Anonymität → niedrigere effektive α, β",
        "earned_vs_windfall": "Earned Endowment → niedrigere β",
        "market_frame": "Markt-Frame → niedrigere α, β"
      },
      "formula": "α_eff = α · ρ(F,m); β_eff = β · ρ(F,m)",
      "confidence": "medium",
      "source": "Cherry et al. (2002), Hoffman et al. (1994)"
    },
    {
      "id": "BR-FS-06",
      "category": "fairness",
      "level": "operation",
      "statement": "Integration mit BCM 2.2: Context-Gated F/S",
      "description": "ρ(F,m) aktiviert F/S-Präferenzen kontextabhängig",
      "formula": "L_aff = ρ(F,m) · [α·max(x_j-x_i,0) + β·max(x_i-x_j,0)]",
      "rho_values": {
        "face_to_face": 1.0,
