{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fehradvice.com/bcm/axiom-schema.json",
  "title": "BCM Axiom Schema",
  "description": "Schema für BCM 2.0 Axiom-Dateien",
  "type": "object",
  "required": ["module", "id", "version", "axiom_count", "categories", "axioms"],
  "properties": {
    "module": {
      "type": "string",
      "enum": ["META", "INU", "KNU", "IDN", "AWX", "WAX", "WTX"],
      "description": "Modul-Name"
    },
    "id": {
      "type": "string",
      "pattern": "^72[0-9]{2}$",
      "description": "Modul-ID (7232-7259)"
    },
    "version": {
      "type": "string",
      "description": "BCM Version"
    },
    "axiom_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Anzahl Axiome im Modul"
    },
    "meta_formula": {
      "type": "string",
      "description": "Zentrale Formel des Moduls"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "range": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          },
          "prefix": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "axioms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/axiom"
      }
    }
  },
  "definitions": {
    "axiom": {
      "type": "object",
      "required": ["id", "category", "level", "statement", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MA-[A-Z]{3}-[0-9]{2}$|^[A-Z]{2,3}-[A-Z]{3}-[0-9]{2}$",
          "description": "Axiom-ID (z.B. MA-ONT-01)"
        },
        "category": {
          "type": "string",
          "description": "Kategorie (ontology, epistemology, etc.)"
        },
        "level": {
          "type": "string",
          "enum": ["foundation", "structure", "operation", "dynamics"],
          "description": "Hierarchie-Ebene"
        },
        "statement": {
          "type": "string",
          "description": "Formale Aussage"
        },
        "description": {
          "type": "string",
          "description": "Erläuterung"
        },
        "formula": {
          "type": "string",
          "description": "Mathematische Formel (optional)"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Abhängige Axiome"
        },
        "validates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Module die validiert werden"
        },
        "corollaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "testable": { "type": "boolean" }
            }
          },
          "description": "Abgeleitete Korollare"
        },
        "testable": {
          "type": "boolean",
          "description": "Empirisch testbar?"
        },
        "references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Literaturverweise"
        }
      }
    }
  }
}
