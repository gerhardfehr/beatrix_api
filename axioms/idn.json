      "testable": true
    },
    {
      "id": "IDN-FS-02",
      "category": "fehr_schmidt",
      "level": "structure",
      "statement": "Asymmetrie: α > β",
      "description": "Benachteiligung schmerzt mehr als Bevorteilung",
      "formula": "α ≥ β; typisch: α ≈ 0.85, β ≈ 0.32",
