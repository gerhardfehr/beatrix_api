{
  "module": "IDN",
  "id": "7245",
  "version": "2.0",
  "axiom_count": 47,
  "description": "Identitätsnutzen-Modul: Integration von Akerlof/Kranton, Bénabou/Henkel, Konow und Fehr/Schmidt",
  "meta_formula": "U_IDN = ω₁·I^AK(a,φ*) + ω₂·I^BH(θ̂,A) - ω₃·SD(φ*,η)",
  "self_deception_formula": "φ*_d = (ω₁κ_d·a_d + ω₃ψ_d·η_d) / (ω₁κ_d + ω₃ψ_d)",
  "full_formula": {
    "U_IDN": "ω₁·Σ_d s_d·[-κ_d(a_d-φ*_d)² - α_d·D⁻_d - β_d·D⁺_d] + ω₂·[s·f(θ̂) + γ·θ̂·A] - ω₃·Σ_d s_d·ψ_d·(φ*_d-η_d)²",
    "components": {
      "AK": "Akerlof/Kranton: Norm-Dissonanz",
      "FS": "Fehr/Schmidt: Inequity Aversion",
      "BH": "Bénabou/Henkel: Self-Image",
      "KO": "Konow: Self-Deception Kosten"
    }
  },
  "categories": {
    "akerlof_kranton": {
      "range": [1, 8],
      "prefix": "AK",
      "description": "Norm-basierte Identität nach Akerlof/Kranton (2000)",
