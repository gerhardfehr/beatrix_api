    },
    "konow": {
      "range": [15, 22],
      "prefix": "KO",
      "description": "Endogene Self-Deception nach Konow (2000)",
      "core_insight": "Fairness-Beliefs sind endogen und passen sich an Verhalten an"
    },
    "fehr_schmidt": {
      "range": [23, 26],
      "prefix": "FS",
      "description": "Inequity Aversion nach Fehr/Schmidt (1999)",
      "core_insight": "Asymmetrische Aversion gegen Benachteiligung (α) und Bevorteilung (β)"
    },
    "types": {
      "range": [27, 31],
      "prefix": "TYP",
      "description": "Verhaltenstypen basierend auf κ/ψ-Konfiguration",
      "empirical_distribution": {
        "Fair": "~40-45%",
        "Self-Deceptive": "~29%",
        "Selfish": "~16%",
        "Complex": "~10%"
      }
    },
    "dynamics": {
      "range": [32, 37],
      "prefix": "DYN",
      "description": "Temporale Dynamik von θ̂ und φ*"
    },
    "integration": {
      "range": [38, 43],
      "prefix": "INT",
      "description": "Integration aller Komponenten in U_IDN"
    },
    "predictions": {
      "range": [44, 47],
