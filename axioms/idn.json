      "testable": true,
      "corollaries": [
        {"id": "DYN-02a", "statement": "Self-Deceptive: a < η aber a ≈ φ* → σ ≈ 0 → θ̂ stabil"},
        {"id": "DYN-02b", "statement": "Selfish: a < η und a < φ* → σ < 0 → θ̂ sinkt"}
      ]
    },
    {
      "id": "IDN-DYN-03",
      "category": "dynamics",
      "level": "structure",
      "statement": "Konvergenz von θ̂",
      "description": "Langfristige Stabilität oder Drift des Selbstbilds",
      "formula": "θ̂_∞ = f(Typ, Verhaltensmuster)",
      "dependencies": ["IDN-DYN-01"],
      "testable": true,
      "corollaries": [
        {"id": "DYN-03a", "statement": "Fair-Typ: θ̂_∞ ≈ 0.80"},
        {"id": "DYN-03b", "statement": "Self-Deceptive: θ̂_∞ ≈ 0.65 (stabil durch SD)"},
        {"id": "DYN-03c", "statement": "Selfish: θ̂_∞ ≈ 0.35 (sinkt bei Konfrontation)"}
      ]
    },
    {
      "id": "IDN-DYN-04",
      "category": "dynamics",
      "level": "operation",
      "statement": "φ*-Drift über Zeit",
      "description": "Self-Deception verstärkt sich nach Entscheidung",
      "formula": "dφ*/dt > 0 wenn a > η (nach unfairer Handlung)",
      "dependencies": ["IDN-KO-07"],
      "references": ["Konow (2000)"],
      "testable": true
    },
    {
      "id": "IDN-DYN-05",
      "category": "dynamics",
      "level": "operation",
      "statement": "PGG Zerfall-Dynamik",
      "description": "In Public Goods Games sinkt η wenn andere weniger beitragen",
      "formula": "η_t = f(ḡ_{-i,t-1}); φ*_t passt sich an → Spirale nach unten",
