      "category": "fehr_schmidt",
      "level": "operation",
      "statement": "Ultimatum Game Erklärung",
      "description": "Ablehnung unfairer Angebote durch hohe α-Werte",
      "formula": "Reject wenn α × (x_P - x_R) > x_R",
      "dependencies": ["IDN-FS-01", "IDN-FS-02"],
      "references": ["Fehr & Schmidt (1999)"],
      "testable": true,
