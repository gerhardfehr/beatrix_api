      "statement": "Simultane Optimierung",
      "description": "Agent optimiert a und φ* simultan",
      "formula": "max_{a, φ*} U_eff s.t. φ* = (ω₁κ·a + ω₃ψ·η)/(ω₁κ + ω₃ψ)",
      "dependencies": ["IDN-INT-01", "IDN-KO-02"],
      "testable": true
    },
