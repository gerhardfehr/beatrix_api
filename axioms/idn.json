      "description": "Testbare Vorhersagen des integrierten Modells"
    }
  },
  "axioms": [
    {
      "id": "IDN-AK-01",
      "category": "akerlof_kranton",
      "level": "foundation",
      "statement": "Identität als additiver Nutzenterm",
      "description": "Identitätsnutzen tritt unabhängig von anderen Präferenzen in die Nutzenfunktion ein",
      "formula": "U = U(a) + I(a; c, ε, P)",
      "references": ["Akerlof & Kranton (2000)"],
      "testable": true
    },
    {
      "id": "IDN-AK-02",
      "category": "akerlof_kranton",
      "level": "foundation",
      "statement": "Soziale Kategorien (c)",
      "description": "Individuen gehören zu sozialen Kategorien die erwartetes Verhalten definieren",
      "formula": "c ∈ {Beruf, Geschlecht, Ethnie, Religion, Organisation, Hobby, ...}",
      "references": ["Akerlof & Kranton (2000)"],
      "testable": true,
      "corollaries": [
        {"id": "AK-02a", "statement": "Mehrfachzugehörigkeit: Individuum hat typischerweise 5-15 aktive Kategorien"},
        {"id": "AK-02b", "statement": "Kategorie-Hierarchie: Nicht alle Kategorien gleich salient"}
      ]
    },
    {
      "id": "IDN-AK-03",
      "category": "akerlof_kranton",
      "level": "foundation",
      "statement": "Präskriptionen (P)",
      "description": "Jede Kategorie hat zugeordnete Verhaltensvorschriften",
      "formula": "P_c: c → {erlaubte_Aktionen, verbotene_Aktionen}",
      "references": ["Akerlof & Kranton (2000)"],
      "testable": true
    },
    {
      "id": "IDN-AK-04",
      "category": "akerlof_kranton",
      "level": "structure",
      "statement": "Salienz-Vektor s(λ, Kontext)",
      "description": "Kontext aktiviert verschiedene Identitätsdimensionen mit unterschiedlicher Stärke",
      "formula": "s_d = f(λ, Kontext); Σ s_d = 1; d ∈ FEPSDE",
      "dependencies": ["IDN-AK-02"],
      "testable": true,
      "corollaries": [
        {"id": "AK-04a", "statement": "F (Functional): Sachlogik, Effizienz"},
        {"id": "AK-04b", "statement": "E (Emotional): Gefühle, Affekt"},
        {"id": "AK-04c", "statement": "P (Political): Macht, Status, Fairness"},
        {"id": "AK-04d", "statement": "S (Social): Zugehörigkeit, Normen"},
        {"id": "AK-04e", "statement": "D (Digital): Technologie-Bezug"},
        {"id": "AK-04f", "statement": "Eco (Ecological): Umwelt, Nachhaltigkeit"}
      ]
    },
    {
      "id": "IDN-AK-05",
      "category": "akerlof_kranton",
      "level": "structure",
      "statement": "Norm-Dissonanz Kosten",
      "description": "Verletzung der Präskription verursacht Identitätsverlust",
      "formula": "L_d(a, P_d) = κ_d × (a_d - P_d)²",
      "dependencies": ["IDN-AK-03", "IDN-AK-04"],
      "testable": true,
      "corollaries": [
        {"id": "AK-05a", "statement": "κ_d > 0: Stärke der Dissonanz-Sensitivität"},
        {"id": "AK-05b", "statement": "Quadratische Form: Kleine Abweichungen weniger schmerzhaft"}
      ]
    },
    {
      "id": "IDN-AK-06",
      "category": "akerlof_kranton",
      "level": "structure",
      "statement": "Akerlof/Kranton Komponente aggregiert",
      "description": "Summe der gewichteten Norm-Dissonanzen über alle Dimensionen",
      "formula": "I^AK(a, φ*) = -Σ_d s_d × κ_d × (a_d - φ*_d)²",
      "dependencies": ["IDN-AK-04", "IDN-AK-05"],
      "testable": true
    },
    {
      "id": "IDN-AK-07",
      "category": "akerlof_kranton",
      "level": "operation",
      "statement": "Identitäts-Bedrohung durch Andere",
      "description": "Andere können die eigene Kategoriezugehörigkeit in Frage stellen",
      "formula": "ΔI = -τ × Threat(c, others)",
      "dependencies": ["IDN-AK-02"],
      "testable": true,
      "references": ["Akerlof & Kranton (2000)"]
    },
    {
      "id": "IDN-AK-08",
      "category": "akerlof_kranton",
      "level": "operation",
      "statement": "Identitäts-Intervention: Salienz-Aktivierung",
      "description": "Bestimmte Identität kann durch Priming aktiviert werden",
      "formula": "s'_d = s_d + Δs_Prime; z.B. 'Als Schweizer...'",
      "dependencies": ["IDN-AK-04"],
      "testable": true
    },
    {
      "id": "IDN-BH-01",
      "category": "benabou_henkel",
      "level": "foundation",
      "statement": "Self-Image als Kapital",
      "description": "Selbstbild θ̂ ist akkumuliertes Kapital aus vergangenen Handlungen",
      "formula": "θ̂ ∈ [0, 1]; 0 = 'schlechter Mensch', 1 = 'guter Mensch'",
      "references": ["Bénabou & Henkel (2025)"],
      "testable": true
    },
    {
      "id": "IDN-BH-02",
      "category": "benabou_henkel",
      "level": "foundation",
      "statement": "Identity Capital A",
      "description": "Akkumulierte Investition in Selbstbild durch vergangene Handlungen",
      "formula": "A = Σ_τ δ^(t-τ) × I(a_τ)",
      "dependencies": ["IDN-BH-01"],
      "references": ["Bénabou & Henkel (2025)"],
      "testable": true
    },
    {
      "id": "IDN-BH-03",
      "category": "benabou_henkel",
      "level": "structure",
      "statement": "Bénabou/Henkel Nutzenkomponente",
      "description": "Nutzen aus Selbstbild und akkumuliertem Identitätskapital",
      "formula": "I^BH(θ̂, A) = s × f(θ̂) + γ × θ̂ × A",
      "dependencies": ["IDN-BH-01", "IDN-BH-02"],
      "references": ["Bénabou & Henkel (2025)"],
      "testable": true,
      "corollaries": [
        {"id": "BH-03a", "statement": "s: Gewicht des reinen Selbstbild-Nutzens"},
        {"id": "BH-03b", "statement": "f(θ̂): Konkave Funktion, z.B. f(θ̂) = θ̂^0.5"},
        {"id": "BH-03c", "statement": "γ: Interaktionseffekt zwischen θ̂ und A"}
      ]
    },
    {
      "id": "IDN-BH-04",
      "category": "benabou_henkel",
      "level": "structure",
      "statement": "Self-Image Updating",
      "description": "θ̂ wird basierend auf Feedback aus Handlungen aktualisiert",
      "formula": "θ̂_{t+1} = (1-δ) × θ̂_t + δ × [α⁺ × σ⁺_t + α⁻ × σ⁻_t]",
      "dependencies": ["IDN-BH-01"],
      "references": ["Bénabou & Henkel (2025)"],
      "testable": true,
      "corollaries": [
        {"id": "BH-04a", "statement": "δ: Update-Rate, typisch 0.1-0.3"},
        {"id": "BH-04b", "statement": "σ⁺: Positives Signal (prosoziale Handlung)"},
        {"id": "BH-04c", "statement": "σ⁻: Negatives Signal (antisoziale Handlung)"},
        {"id": "BH-04d", "statement": "α⁺ > α⁻: Asymmetrie (Positives stärker gewichtet)"}
      ]
    },
    {
      "id": "IDN-BH-05",
      "category": "benabou_henkel",
      "level": "operation",
      "statement": "Signal-Generierung aus Handlung",
      "description": "Handlung generiert Self-Image Signal relativ zu subjektiver Norm φ*",
      "formula": "σ_t = h(a_t, φ*_t); σ > 0 wenn a > φ*, σ < 0 wenn a < φ*",
      "dependencies": ["IDN-BH-04", "IDN-KO-02"],
      "testable": true
    },
    {
      "id": "IDN-BH-06",
      "category": "benabou_henkel",
      "level": "operation",
      "statement": "Selektive Erinnerung",
      "description": "Menschen erinnern sich besser an identitätskonsistente Handlungen",
      "formula": "P(recall | σ⁺) > P(recall | σ⁻) wenn θ̂ hoch",
      "dependencies": ["IDN-BH-01", "IDN-BH-04"],
      "references": ["Bénabou & Tirole (2002)"],
      "testable": true
    },
    {
      "id": "IDN-KO-01",
      "category": "konow",
      "level": "foundation",
      "statement": "Objektive vs. Subjektive Fairness-Norm",
      "description": "η ist objektive Norm, φ* ist endogen angepasste subjektive Norm",
      "formula": "η: exogen gegeben; φ*: endogen optimiert",
      "references": ["Konow (2000)"],
      "testable": true
    },
    {
      "id": "IDN-KO-02",
      "category": "konow",
      "level": "foundation",
      "statement": "Endogene Self-Deception",
      "description": "Subjektive Norm φ* ist gewichteter Durchschnitt aus Handlung und objektiver Norm",
      "formula": "φ*_d = (ω₁κ_d × a_d + ω₃ψ_d × η_d) / (ω₁κ_d + ω₃ψ_d)",
      "dependencies": ["IDN-KO-01"],
      "references": ["Konow (2000)"],
      "testable": true,
      "corollaries": [
        {"id": "KO-02a", "statement": "κ_d hoch, ψ_d niedrig → φ* nahe bei a (Self-Deception möglich)"},
        {"id": "KO-02b", "statement": "κ_d niedrig, ψ_d hoch → φ* nahe bei η (keine Self-Deception)"},
        {"id": "KO-02c", "statement": "κ_d = ψ_d → φ* = (a + η) / 2"}
      ]
    },
    {
      "id": "IDN-KO-03",
      "category": "konow",
      "level": "structure",
      "statement": "Self-Deception Kosten",
      "description": "Abweichung von objektiver Norm verursacht kognitive Kosten",
      "formula": "SD(φ*, η) = Σ_d s_d × ψ_d × (φ*_d - η_d)²",
      "dependencies": ["IDN-KO-01", "IDN-KO-02"],
      "references": ["Konow (2000)"],
      "testable": true,
      "corollaries": [
        {"id": "KO-03a", "statement": "ψ_d: Self-Deception Kosten-Parameter"},
        {"id": "KO-03b", "statement": "Hohe ψ → teure Self-Deception → weniger Verzerrung"}
      ]
    },
    {
      "id": "IDN-KO-04",
      "category": "konow",
      "level": "structure",
      "statement": "Dissonanz-Kosten bei gegebenem φ*",
      "description": "Handlung die von subjektiver Norm abweicht verursacht Dissonanz",
      "formula": "Dissonanz = Σ_d s_d × κ_d × (a_d - φ*_d)²",
      "dependencies": ["IDN-KO-02", "IDN-AK-05"],
      "testable": true
    },
    {
      "id": "IDN-KO-05",
      "category": "konow",
      "level": "operation",
      "statement": "Trade-off: Dissonanz vs. Self-Deception",
      "description": "Optimale φ* balanciert Dissonanz-Kosten gegen Self-Deception-Kosten",
      "formula": "min_{φ*} [κ(a - φ*)² + ψ(φ* - η)²]",
      "dependencies": ["IDN-KO-03", "IDN-KO-04"],
      "references": ["Konow (2000)"],
      "testable": true
    },
    {
      "id": "IDN-KO-06",
      "category": "konow",
      "level": "operation",
      "statement": "Empirische Self-Deception Rate",
      "description": "~71% der unfairen Dictator-Geber zeigen Self-Deception",
      "formula": "P(Self-Deception | Unfair) ≈ 0.71",
      "references": ["Konow (2000), S. 1083"],
      "testable": true,
      "empirical_evidence": {
        "source": "Konow (2000)",
        "finding": "71% of unfair allocators showed self-deception",
        "method": "Post-decision fairness beliefs vs. objective norm"
      }
    },
    {
      "id": "IDN-KO-07",
      "category": "konow",
      "level": "operation",
      "statement": "Self-Deception verstärkt sich über Zeit",
      "description": "Fairness-Beliefs driften weiter von η weg nach Verzögerung",
      "formula": "φ*_{t+Δ} > φ*_t wenn a > η (nach unfairer Handlung)",
      "dependencies": ["IDN-KO-02"],
      "references": ["Konow (2000), S. 1087"],
      "testable": true
    },
    {
      "id": "IDN-KO-08",
      "category": "konow",
      "level": "operation",
      "statement": "Information reduziert Self-Deception",
      "description": "Explizite Kommunikation von η erhöht ψ und reduziert Verzerrung",
      "formula": "ψ_explicit > ψ_implicit → φ*_explicit näher an η",
      "dependencies": ["IDN-KO-02", "IDN-KO-03"],
      "testable": true
    },
    {
      "id": "IDN-FS-01",
      "category": "fehr_schmidt",
      "level": "foundation",
      "statement": "Inequity Aversion",
      "description": "Menschen haben Aversion gegen ungleiche Verteilungen",
      "formula": "U_FS = x_i - α × max(x_j - x_i, 0) - β × max(x_i - x_j, 0)",
