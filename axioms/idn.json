      "id": "IDN-INT-01",
      "category": "integration",
      "level": "foundation",
      "statement": "Vollständige U_IDN Formel",
      "description": "Integration aller vier Komponenten",
      "formula": "U_IDN = ω₁·I^AK(a,φ*) + ω₂·I^BH(θ̂,A) - ω₃·SD(φ*,η)",
