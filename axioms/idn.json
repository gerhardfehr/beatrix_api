        {"id": "TYP-04d", "statement": "θ̂: Variabel"}
      ]
    },
    {
      "id": "IDN-TYP-05",
      "category": "types",
      "level": "operation",
      "statement": "Typ-Identifikation durch κ/ψ-Ratio",
      "description": "Verhältnis von κ zu ψ bestimmt Self-Deception-Tendenz",
