      "dependencies": ["IDN-TYP-01", "IDN-TYP-02", "IDN-TYP-03", "IDN-TYP-04"],
      "testable": true
    },
    {
      "id": "IDN-DYN-01",
      "category": "dynamics",
      "level": "foundation",
      "statement": "θ̂-Update Gleichung",
      "description": "Self-Image Update basierend auf Handlungs-Signal",
      "formula": "θ̂_{t+1} = (1-δ) × θ̂_t + δ × [α⁺ × σ⁺_t + α⁻ × σ⁻_t]",
      "dependencies": ["IDN-BH-04"],
      "testable": true
    },
    {
      "id": "IDN-DYN-02",
      "category": "dynamics",
      "level": "foundation",
      "statement": "Signal relativ zu φ*, nicht η",
      "description": "Kritisch: Signal basiert auf subjektiver Norm",
      "formula": "σ_t = h(a_t, φ*_t); NICHT h(a_t, η_t)",
