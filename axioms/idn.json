      "testable": true
    },
    {
      "id": "IDN-INT-02",
      "category": "integration",
      "level": "foundation",
      "statement": "Erweiterte I^AK mit Inequity Aversion",
      "description": "Akerlof/Kranton Komponente inkludiert Fehr/Schmidt",
      "formula": "I^AK = Σ_d s_d × [-κ_d(a_d-φ*_d)² - α_d×D⁻_d - β_d×D⁺_d]",
      "dependencies": ["IDN-AK-06", "IDN-FS-03"],
      "testable": true
    },
    {
      "id": "IDN-INT-03",
      "category": "integration",
      "level": "structure",
      "statement": "Gewichte ω₁, ω₂, ω₃",
      "description": "Relative Gewichte der drei Hauptkomponenten",
      "formula": "ω₁ + ω₂ + ω₃ = 1; typisch: ω₁ ≈ 0.5, ω₂ ≈ 0.2, ω₃ ≈ 0.3",
      "dependencies": ["IDN-INT-01"],
      "testable": true,
      "corollaries": [
        {"id": "INT-03a", "statement": "ω₁: Norm-Konformität Gewicht"},
        {"id": "INT-03b", "statement": "ω₂: Self-Image Gewicht"},
        {"id": "INT-03c", "statement": "ω₃: Self-Deception Kosten Gewicht"}
      ]
    },
    {
      "id": "IDN-INT-04",
      "category": "integration",
      "level": "structure",
      "statement": "Einbettung in BCM Gesamtformel",
      "description": "U_IDN tritt additiv und unabhängig von λ in U_eff ein",
      "formula": "U_eff = (1-λ) × U_INU + λ × U_KNU + U_IDN",
      "dependencies": ["IDN-INT-01"],
      "references": ["Akerlof & Kranton (2000)", "LAM-INT-01"],
      "testable": true
    },
