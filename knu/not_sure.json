{
    "module": {
        "id": "7235",
        "name": "BCM2_02_Collective Benefit",
        "version": "3.1",
        "description": "Extended axiomatics of collective benefit with destruction logic (A43–A46), including dispositional and behavior-based components.",
        "axioms": [
            {
                "id": "A43",
                "title": "Antisocial Punishment (Destruction Condition)",
                "formula": "Pun_anti = Pun * (1 - Legit) * (1 - NormCoh)",
                "description": "Punishment without legitimacy and without normative coherence destroys collective benefit.",
                "linked_axioms": [
                    "A31",
                    "A35",
                    "A40",
                    "A41"
                ],
                "empirical_reference": "Herrmann, Thöni & Gächter (2008), Science 319, 1362–1367"
            },
            {
                "id": "A44",
                "title": "Dispositional Amplification (Dark Triad Extension I)",
                "formula": "Θ_DT = α_M*M + α_N*N + α_P*P",
                "description": "Machiavellianism (M), narcissism (N), and psychopathy (P) amplify the intensity of antisocial punishment. Each component affects legitimacy, norm coherence, and punishment differently.",
                "linked_axioms": [
                    "A43"
                ],
                "parameters": {
                    "α_M": 0.4,
                    "α_N": 0.35,
                    "α_P": 0.25
                },
                "empirical_reference": "Paulhus & Williams (2002); Jones & Paulhus (2014)"
            },
            {
                "id": "A45",
                "title": "Behavior-Based Indicators (A43 Decalogue Extension II)",
                "formula": "Θ_Beh = Σ_i β_i * v_i, i=1..10",
                "description": "Ten micro-social behavioral patterns signal the activation of antisocial punishment.",
                "behavioral_indicators": [
                    {
                        "id": 1,
                        "name": "Gaslighting",
                        "β": 0.1
                    },
                    {
                        "id": 2,
                        "name": "Guilt-Tripping",
                        "β": 0.1
                    },
                    {
                        "id": 3,
                        "name": "Silent Treatment",
                        "β": 0.1
                    },
                    {
                        "id": 4,
                        "name": "Love Bombing",
                        "β": 0.07
                    },
                    {
                        "id": 5,
                        "name": "Playing the Victim",
                        "β": 0.1
                    },
                    {
                        "id": 6,
                        "name": "Triangulation",
                        "β": 0.1
                    },
                    {
                        "id": 7,
                        "name": "Emotional Blackmail",
                        "β": 0.1
                    },
                    {
                        "id": 8,
                        "name": "Social Undermining",
                        "β": 0.1
                    },
                    {
                        "id": 9,
                        "name": "Exclusion Signaling",
                        "β": 0.1
                    },
                    {
                        "id": 10,
                        "name": "Moral Framing Punishment",
                        "β": 0.13
                    }
                ],
                "linked_axioms": [
                    "A43",
                    "A44"
                ],
                "empirical_reference": "FehrAdvice Research (2025)"
            },
            {
                "id": "A46",
                "title": "Destruction Function with Disposition and Behavior (A43-DTX Extension III)",
                "formula": "Pun_anti_DTX = Pun * (1 - Legit) * (1 - NormCoh) * (1 + Θ_DT) * (1 + Θ_Beh)",
                "description": "Extended destruction condition: antisocial punishment is multiplicatively amplified by dispositional (Dark Triad) and behavior-based (A43 Decalogue) factors.",
                "linked_axioms": [
                    "A43",
                    "A44",
                    "A45"
                ],
                "empirical_reference": "FehrAdvice & Partners AG – BCM 2.1 Simulation Engine"
            }
        ],
        "requirements": "In addition to contribution and outcome data, dispositional indices (M, N, P) and behavioral indicators v₁…v₁₀ are required.",
        "integration": {
            "modules": [
                "9495",
                "9251",
                "7240",
                "7236",
                "7243"
            ],
            "purpose": "Monitoring Pun_anti risk via disposition and behavior"
        },
        "version_history": [
            {
                "version": "3.0",
                "change": "Added punishment, incentive, and stability axioms (A31–A42)."
            },
            {
                "version": "3.1",
                "change": "Extended with A43–A46 (destruction logic incl. Dark Triad and behavioral indicators)."
            }
        ],
        "citations": [
            "Fehr & Gächter (2000ff.): Public Goods Experiments",
            "Ostrom (1990): Governing the Commons",
            "Herrmann, Thöni & Gächter (2008): Antisocial Punishment Across Societies",
            "Paulhus & Williams (2002): The Dark Triad of Personality",
            "FehrAdvice & Partners AG (2025): BCM 2.1 A43-DTX Extension"
        ]
    },
    "axiom_objects": [
        {
            "meta": {
                "axiom_id": "A47",
                "name": "Cooperation Complementarity",
                "module": "7235_KNU",
                "version": "3.2-pre",
                "author": "FehrAdvice & Partners AG",
                "source": "Research Draft 2025-08",
                "status": "VALIDATED"
            },
            "structure": {
                "expression": "dU_i/dU_j > 0 if Trust_ij > 0.4 and NormCoh > 0.5",
                "variables": {
                    "U_i": "Individual utility of actor i",
                    "U_j": "Individual utility of actor j",
                    "Trust_ij": "Trust level between actors",
                    "NormCoh": "Coherence of social norms"
                },
                "type": "ConditionalPartialDerivative"
            },
            "interpretation": {
                "description": "Positive interdependence between individual utility functions under sufficient trust and norm coherence. Increases collective stability and reduces institutional steering.",
                "implication": "Specification of 0.00c (interaction) in positive mode."
            },
            "links": {
                "references": [
                    "7234_INU",
                    "7243_WAX",
                    "8904_KON"
                ],
                "crossrefs": [
                    "0.00c_META",
                    "0.00d_META"
                ]
            },
            "audit": {
                "watchdog_module": "9251",
                "criteria": {
                    "lambda_pos": "> 0",
                    "Delta_lambda_pos": "< 0.05",
                    "Trust_ij": ">= 0.4",
                    "NormCoh": ">= 0.5"
                },
                "audit_level": "CE_OK",
                "last_review": "2025-10-18",
                "audit_status": "ACTIVE"
            }
        },
        {
            "meta": {
                "axiom_id": "A48",
                "name": "Feedback Aggregation (IND↔COL)",
                "module": "7235_KNU",
                "version": "3.2-pre",
                "author": "FehrAdvice & Partners AG",
                "source": "Research Draft 2025-11",
                "status": "ACTIVE"
            },
            "structure": {
                "expression": "N_kol(t+1) = N_kol(t) + η*Σ(ΔU_ind,i) - ζ*(Σλ_pos - 1)^2",
                "variables": {
                    "N_kol": "Collective benefit at time t",
                    "ΔU_ind,i": "Utility change of individual actors i",
                    "η": "Learning rate (amplification factor)",
                    "ζ": "Damping coefficient (stability factor)",
                    "λ_pos": "Positive interdependence (from A47)"
                },
                "type": "FeedbackFunction"
            },
            "interpretation": {
                "description": "Feedback loop between individual and collective benefit. Regulates the reinforcement triggered by positive interdependences (A47) to avoid over-complementarity and ensure system stability.",
                "implication": "A48 fulfills Meta-Axiom 0.00d (closure) and prepares A49 (norm-coherence dynamics)."
            },
            "links": {
                "references": [
                    "7234_INU",
                    "8904_KON",
                    "9492_KOM"
                ],
                "crossrefs": [
                    "A47",
                    "0.00a_META",
                    "0.00d_META"
                ]
            },
            "audit": {
                "watchdog_module": "9251",
                "criteria": {
                    "ζ": "> 0",
                    "|Σλ_pos - 1|": "< 0.2",
                    "Stab_KNU": ">= 0.9"
                },
                "audit_level": "CE_OK",
                "last_review": "2025-11-07",
                "audit_status": "ACTIVE"
            }
        },
        {
            "meta": {
                "axiom_id": "A49",
                "name": "Norm Coherence Dynamics",
                "module": "7235_KNU",
                "version": "3.2-pre",
                "author": "FehrAdvice & Partners AG",
                "source": "Research Draft 2025-11",
                "status": "ACTIVE"
            },
            "structure": {
                "expression": "NormCoh(t+1) = NormCoh(t) + γ*(Legit(t) - Pun_anti(t)) - δ*|Σλ_pos - 1|",
                "variables": {
                    "NormCoh": "Norm coherence index",
                    "Legit": "Legitimacy level of the collective",
                    "Pun_anti": "Illegitimate or destructive punishment intensity",
                    "λ_pos": "Positive interdependence (from A47)",
                    "γ": "Amplification factor (learning rate)",
                    "δ": "Damping coefficient for over-complementarity"
                },
                "type": "AdaptiveDifferentialFunction"
            },
            "interpretation": {
                "description": "Dynamic adjustment of norm coherence depending on legitimacy, destructive punishment, and cooperation density. A49 stabilizes the normative equilibrium by amplifying legitimacy gains and damping over-cooperation.",
                "implication": "Secures social legitimation of collective behavior. Fulfills Meta-Axioms 0.00d (closure) and 0.00e (operationality)."
            },
            "links": {
                "references": [
                    "7235_KNU",
                    "8904_KON",
                    "7240_AWX",
                    "7243_WAX"
                ],
                "crossrefs": [
                    "A47",
                    "A48",
                    "0.00d_META",
                    "0.00e_META"
                ]
            },
            "audit": {
                "watchdog_module": "9251",
                "criteria": {
                    "γ": "> 0",
                    "δ": "> 0",
                    "|ΔNormCoh|": "< 0.05",
                    "|Σλ_pos - 1|": "< 0.2",
                    "Legit": ">= 0.5"
                },
                "audit_level": "CE_OK",
                "last_review": "2025-11-07",
                "audit_status": "ACTIVE"
            }
        },
        {
            "meta": {
