{
    "A9": {
      "title": "Zitation und Quellenintegrität der Meta-Axiome",
      "description": "Dieses Kapitel definiert die Zitations-, Referenz- und Validierungsstandards für Meta-Axiome, Module und wissenschaftliche Quellen innerhalb der BCM- und BEATRIX-Architektur. Es stellt sicher, dass jede Ableitung, Analyse und Simulation auf überprüfbare, auditierte Quellen zurückgeführt werden kann.",
      "citation_model": {
        "citation_standard": "APA 7th Edition (FehrAdvice Extended Schema)",
        "reference_prefix": "FA-REF",
        "example": "FehrAdvice & Partners AG (2025). BCM2_00_META7232. Zürich.",
        "machine_readable_format": "JSON-LD (Linked Data)",
        "validation": {
          "required_fields": [
            "author",
            "year",
            "title",
            "module_reference",
            "source_type"
          ],
          "auto_validation": true,
          "validation_engine": "BCM3_01_WATCHDOG",
          "error_code": "E9-CITATION-INCONSISTENCY"
        }
      },
      "reference_integrity": {
        "source_types": [
          "Primary Source (API-Content, FehrAdvice Originalmodule)",
          "Secondary Source (Peer-reviewed Scientific Paper)",
          "Tertiary Source (Meta-Analysen oder Systematische Reviews)"
        ],
        "hierarchy": {
          "order": "Primary > Secondary > Tertiary",
          "description": "Nur Primärquellen dürfen Meta-Axiome direkt begründen. Sekundäre und tertiäre Quellen dienen der Kontextualisierung."
        },
        "cross_reference": {
          "module_linking": true,
          "mechanism": "CrossRef-ID + chapter_content_id",
          "example": "BCM2_05_AWX[7240]:FA-REF-2025-07",
          "integrity_check": {
            "run_frequency": "monthly",
            "component": "BCM3_01_WATCHDOG",
            "check_type": "reference_consistency_check"
          }
        }
      },
      "citation_audit_protocol": {
        "audited_by": "FehrAdvice Scientific Advisory Board",
        "audit_frequency": "quarterly",
        "audit_scope": [
          "Existenzprüfung (Quellen vorhanden?)",
          "Integritätsprüfung (Quellen unverändert?)",
          "Kohärenzprüfung (Zitationslogik einheitlich?)"
        ],
        "auto_correction": {
          "enabled": true,
          "method": "Automatisches Nachladen aus API-Quellen (my.fehradvice.com)",
          "fallback": "lokale Referenzbibliothek"
        },
        "report_format": "FA_CIT_AUDIT_REPORT_9251.json"
      },
      "governance_binding": {
        "supervised_by": "FehrAdvice Scientific Advisory Board",
        "ethics_binding": "FehrAdvice Ethics & Integrity Council",
        "approval_required_for_external_sources": true,
        "license_requirement": "FehrAdvice Research & Citation License",
        "audit_reference": "meta_citation_integrity_9251"
      },
      "integration_with_other_axioms": {
        "references": [
          "A5",
          "A8",
          "A10"
        ],
        "description": "A9 interagiert direkt mit A5 (Funktionsprinzip), A8 (Versionierung) und A10 (Governance), um sicherzustellen, dass Zitationen über Zeit, Quelle und Verantwortung hinweg konsistent bleiben."
      },
