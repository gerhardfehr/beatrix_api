    "A1_Context": {
        "module_name": "BCM2_13_INT9250 - Interventionsbaukasten",
        "context": "Part of the BCM 2.0 intervention architecture; manages single interventions, combinations, and path logics to generate stable behavioral change. Central for context-based, segmented, path-integrated strategies in BCM 2.0."
    },
    "A2_Scope": {
        "applicable_context_levels": [
            "state_federal",
            "state_regional",
            "state_municipal",
            "organizational_companies",
            "organizational_public_administration",
            "organizational_ngos",
            "institutional_associations",
            "institutional_initiatives",
            "family_and_individual",
            "digital_platforms_algorithms_apps"
        ],
        "intervention_classes": [
            "classic",
            "behavioral",
            "normative",
            "structural",
            "hybrid"
        ]
    },
    "A3_Objectives_and_Function": {
        "objectives": [
            "Standardized capture and modeling of BCM-compatible interventions",
            "Combinability of interventions along behavioral-economic paths",
            "Simulatability of effects, side effects, reactance, and reinforcement",
            "Operationalization of complementarities",
            "Design of segment- and context-appropriate intervention portfolios"
        ],
        "function": "Core module for measure architecture, policy design, nudging strategies, and redesign of decision contexts."
    },
